# FundAgent AI 环境变量示例（复制为 .env 或直接 export）
# 默认即本机 Ollama，无需修改；以下为可选项。

# ---- LLM（默认：本机 Ollama + qwen3.5:9b）----
# real = 调用真实 LLM；mock = 离线模板（Ollama 不可用时的兜底）
FUNDAGENT_LLM_MODE=real
FUNDAGENT_LLM_BASE_URL=http://localhost:11434/v1
FUNDAGENT_LLM_API_KEY=ollama
FUNDAGENT_LLM_MODEL=qwen3.5:9b
# qwen3.5 为思考模型，必须关闭 thinking，否则 content 返回空
FUNDAGENT_LLM_THINK=false
# 本地推理超时（秒），长报告生成可适当调大
FUNDAGENT_LLM_TIMEOUT=180

# ---- 切换到其他 OpenAI 兼容服务（DashScope/DeepSeek/vLLM）----
# FUNDAGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FUNDAGENT_LLM_API_KEY=sk-xxx
# FUNDAGENT_LLM_MODEL=qwen-plus

# ---- 服务 ----
FUNDAGENT_HOST=127.0.0.1
FUNDAGENT_PORT=8000
FUNDAGENT_JWT_SECRET=fundagent-ai-dev-secret-2026-please-change-in-prod

# ---- Checkpointer 后端 ----
# sqlite（默认，零依赖）| redis（Docker 部署）
FUNDAGENT_CHECKPOINTER_BACKEND=sqlite
# Docker Redis（映射到宿主机 8379）：
FUNDAGENT_REDIS_URL=redis://localhost:8379/0
# 容器设了 requirepass 才需要：
FUNDAGENT_REDIS_PASSWORD=
# checkpoint TTL（天）：0=不过期；生产建议 90
FUNDAGENT_CHECKPOINTER_TTL_DAYS=0
